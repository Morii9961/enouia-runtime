{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only Core operator inspection/export v1 (backend design only)",
  "description": "Closed shapes only; backend observation, full bundle/lineage, exact export bytes, authorization and safe source/destination ports remain unimplemented. No selector repair or initialization.",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/exportRequest"
    }
  ],
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "byte_length",
        "sha256",
        "binding"
      ],
      "properties": {
        "kind": {
          "enum": [
            "valid",
            "absent",
            "invalid",
            "unreadable"
          ]
        },
        "byte_length": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "../invocation/record-v1.schema.json#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "../invocation/record-v1.schema.json#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "inspection_id",
        "process_id",
        "root_observation_id",
        "observed_at",
        "root_verified",
        "scan_complete",
        "selector",
        "canonical_binding",
        "candidates",
        "observed_counts",
        "issue_codes",
        "canonical_writes_allowed"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "operator_inspection"
        },
        "inspection_id": {
          "type": "string",
          "pattern": "^insp_[0-9a-f]{32}$"
        },
        "process_id": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "root_observation_id": {
          "type": "string",
          "pattern": "^obs_[0-9a-f]{32}$"
        },
        "observed_at": {
          "$ref": "../invocation/record-v1.schema.json#/$defs/time"
        },
        "root_verified": {
          "type": "boolean"
        },
        "scan_complete": {
          "type": "boolean"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "canonical_binding": {
          "anyOf": [
            {
              "$ref": "../invocation/record-v1.schema.json#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "lineage_complete",
              "model_valid"
            ],
            "properties": {
              "binding": {
                "$ref": "../invocation/record-v1.schema.json#/$defs/binding"
              },
              "lineage_complete": {
                "type": "boolean"
              },
              "model_valid": {
                "type": "boolean"
              }
            }
          }
        },
        "observed_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generations",
            "staging",
            "unreferenced_raw",
            "orphans"
          ],
          "properties": {
            "generations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "staging": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "unreferenced_raw": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "orphans": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            }
          }
        },
        "issue_codes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "root_refused",
              "root_unavailable",
              "selector_absent",
              "selector_invalid",
              "selector_unreadable",
              "lineage_invalid",
              "bundle_invalid",
              "orphan_present",
              "scan_limit"
            ]
          }
        },
        "canonical_writes_allowed": {
          "const": false
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "plan_id",
        "inspection_id",
        "process_id",
        "root_observation_id",
        "destination_id",
        "created_at",
        "purpose",
        "target_binding",
        "selector_observation",
        "lineage",
        "files",
        "raw_objects",
        "entry_count",
        "total_bytes",
        "canonical_changes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "operator_export_plan"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^exp_[0-9a-f]{32}$"
        },
        "inspection_id": {
          "type": "string",
          "pattern": "^insp_[0-9a-f]{32}$"
        },
        "process_id": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "root_observation_id": {
          "type": "string",
          "pattern": "^obs_[0-9a-f]{32}$"
        },
        "destination_id": {
          "type": "string",
          "pattern": "^dst_[0-9a-f]{32}$"
        },
        "created_at": {
          "$ref": "../invocation/record-v1.schema.json#/$defs/time"
        },
        "purpose": {
          "enum": [
            "selected_history",
            "named_history"
          ]
        },
        "target_binding": {
          "$ref": "../invocation/record-v1.schema.json#/$defs/binding"
        },
        "selector_observation": {
          "$ref": "#/$defs/selector"
        },
        "lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "parent"
            ],
            "properties": {
              "binding": {
                "$ref": "../invocation/record-v1.schema.json#/$defs/binding"
              },
              "parent": {
                "$ref": "../vault/storage-v1.schema.json#/$defs/parent"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generation_id",
              "path",
              "byte_length",
              "sha256"
            ],
            "properties": {
              "generation_id": {
                "$ref": "../vault/storage-v1.schema.json#/$defs/generationId"
              },
              "path": {
                "anyOf": [
                  {
                    "$ref": "../vault/storage-v1.schema.json#/$defs/path"
                  },
                  {
                    "const": "manifest.json"
                  }
                ]
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "sha256": {
                "$ref": "../invocation/record-v1.schema.json#/$defs/hash"
              }
            }
          }
        },
        "raw_objects": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "../vault/storage-v1.schema.json#/$defs/raw"
          }
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "canonical_changes": {
          "const": false
        }
      }
    },
    "exportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "plan_id",
        "inspection_id",
        "process_id",
        "destination_id",
        "expected_plan_sha256",
        "client_request_id"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "export_reviewed"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^exp_[0-9a-f]{32}$"
        },
        "inspection_id": {
          "type": "string",
          "pattern": "^insp_[0-9a-f]{32}$"
        },
        "process_id": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "destination_id": {
          "type": "string",
          "pattern": "^dst_[0-9a-f]{32}$"
        },
        "expected_plan_sha256": {
          "$ref": "../invocation/record-v1.schema.json#/$defs/hash"
        },
        "client_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,64}$"
        }
      }
    }
  }
}
