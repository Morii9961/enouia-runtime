{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized public ActivityData v1",
  "description": "Output shape. Unknown input fields may be discarded by the Rust normalizer. Real dates, uniqueness, parseable timestamps, and safe sums are enforced by Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": { "const": 1 },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "codex", "claude"],
      "properties": {
        "github": { "$ref": "#/$defs/github" },
        "codex": { "$ref": "#/$defs/codex" },
        "claude": { "$ref": "#/$defs/claude" }
      }
    }
  },
  "$defs": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "value"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" },
        "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "github": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/snapshotGithub" }
      ]
    },
    "codex": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/snapshotCodex" }
      ]
    },
    "claude": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/snapshotClaude" }
      ]
    },
    "snapshotGithub": {
      "type": "object", "additionalProperties": false,
      "required": ["updatedAt", "timezone", "metric", "days"],
      "properties": {
        "updatedAt": { "type": "string" },
        "timezone": { "const": "GitHub" },
        "metric": { "const": "contributions" },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" } }
      }
    },
    "snapshotCodex": {
      "type": "object", "additionalProperties": false,
      "required": ["updatedAt", "timezone", "metric", "days"],
      "properties": {
        "updatedAt": { "type": "string" },
        "timezone": { "const": "Codex" },
        "metric": { "const": "tokens" },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" } }
      }
    },
    "snapshotClaude": {
      "type": "object", "additionalProperties": false,
      "required": ["updatedAt", "timezone", "metric", "days"],
      "properties": {
        "updatedAt": { "type": "string" },
        "timezone": { "const": "Asia/Shanghai" },
        "metric": { "const": "tokens" },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" } }
      }
    }
  }
}
