{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Activity upload batch v1",
  "description": "Normalized receiver shape. Legacy input may omit succeededAt; Rust derives it from data. Timestamp ordering and source outcome relations are enforced by Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "producer", "sequence", "createdAt", "sources", "data"],
  "properties": {
    "version": { "const": 1 },
    "producer": { "const": "morii-workstation" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "createdAt": { "$ref": "#/$defs/exactTimestamp" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "codex", "claude"],
      "properties": {
        "github": { "$ref": "#/$defs/outcome" },
        "codex": { "$ref": "#/$defs/outcome" },
        "claude": { "$ref": "#/$defs/outcome" }
      }
    },
    "data": { "$ref": "activity-data-v1.schema.json" }
  },
  "$defs": {
    "exactTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptedAt", "succeededAt", "result"],
      "properties": {
        "attemptedAt": { "$ref": "#/$defs/exactTimestamp" },
        "succeededAt": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "result": { "enum": ["success", "failed"] }
      }
    }
  }
}
