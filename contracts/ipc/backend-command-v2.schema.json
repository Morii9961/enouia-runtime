{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed backend command envelope v2 (not enabled IPC)",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "clientRequestId", "expectedBinding", "operation"],
  "properties": {
    "schemaVersion": {"const": 2},
    "clientRequestId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$"},
    "expectedBinding": {"$ref": "../invocation/record-v1.schema.json#/$defs/binding"},
    "operation": {"oneOf": [
      {"$ref": "#/$defs/save"}, {"$ref": "#/$defs/review"}, {"$ref": "#/$defs/undo"},
      {"$ref": "#/$defs/createSession"}, {"$ref": "#/$defs/appendTurn"}, {"$ref": "#/$defs/checkpoint"},
      {"$ref": "#/$defs/identity"}, {"$ref": "#/$defs/send"}, {"$ref": "#/$defs/continue"},
      {"$ref": "#/$defs/resume"}, {"$ref": "#/$defs/cancel"}, {"$ref": "#/$defs/cancelSubmission"}
    ]}
  },
  "$defs": {
    "save": {
      "type":"object", "additionalProperties":false, "required":["kind","saveMode","draft"],
      "properties":{"kind":{"const":"save_memory"},"saveMode":{"enum":["inspector","remember"]},"draft":{"$ref":"../memory/draft-v1.schema.json"}}
    },
    "review": {
      "type":"object", "additionalProperties":false, "required":["kind","candidateId","review"],
      "properties":{"kind":{"const":"review_candidate"},"candidateId":{"type":"string","pattern":"^cand_[0-9a-f]{32}$"},"review":{"$ref":"core-v1.schema.json#/$defs/candidateReview"}}
    },
    "undo": {
      "type":"object", "additionalProperties":false, "required":["kind","memoryId"],
      "properties":{"kind":{"const":"undo_supersession"},"memoryId":{"type":"string","pattern":"^mem_[0-9a-f]{32}$"}}
    },
    "createSession": {
      "type":"object", "additionalProperties":false, "required":["kind","title"],
      "properties":{"kind":{"const":"create_session"},"title":{"type":"string","minLength":1,"maxLength":256}}
    },
    "appendTurn": {
      "type":"object", "additionalProperties":false, "required":["kind","sessionId","content"],
      "properties":{"kind":{"const":"append_user_turn"},"sessionId":{"$ref":"#/$defs/sessionId"},"content":{"type":"string","minLength":1,"maxLength":65536}}
    },
    "checkpoint": {
      "type":"object", "additionalProperties":false, "required":["kind","sessionId","coveredTurns","lastState","openLoops"],
      "properties":{"kind":{"const":"create_checkpoint"},"sessionId":{"$ref":"#/$defs/sessionId"},"coveredTurns":{"$ref":"../memory/models-v1.schema.json#/$defs/turnRange"},"lastState":{"type":"string","minLength":1,"maxLength":65536},"openLoops":{"type":"array","maxItems":256,"items":{"type":"string","minLength":1,"maxLength":4096}}}
    },
    "identity": {
      "type":"object", "additionalProperties":false, "required":["kind","name","content"],
      "properties":{"kind":{"const":"update_identity"},"name":{"enum":["core.md","runtime_rules.md"]},"content":{"type":"string","minLength":1,"maxLength":65536}}
    },
    "send": {
      "type":"object", "additionalProperties":false, "required":["kind","sessionId","content","projectId","maxTokens"],
      "properties":{"kind":{"const":"send_mock_turn"},"sessionId":{"$ref":"#/$defs/sessionId"},"content":{"type":"string","minLength":1,"maxLength":1024},"projectId":{"anyOf":[{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},{"type":"null"}]},"maxTokens":{"type":"integer","minimum":256,"maximum":32768}}
    },
    "continue": {
      "type":"object", "additionalProperties":false, "required":["kind","sessionId","userTurnId","projectId","maxTokens"],
      "properties":{"kind":{"const":"continue_user_turn"},"sessionId":{"$ref":"#/$defs/sessionId"},"userTurnId":{"type":"string","pattern":"^turn_[0-9a-f]{32}$"},"projectId":{"anyOf":[{"type":"string","pattern":"^prj_[0-9a-f]{32}$"},{"type":"null"}]},"maxTokens":{"type":"integer","minimum":256,"maximum":32768}}
    },
    "resume": {
      "type":"object", "additionalProperties":false, "required":["kind","invocationId"],
      "properties":{"kind":{"const":"resume_invocation"},"invocationId":{"$ref":"#/$defs/invocationId"}}
    },
    "cancel": {
      "type":"object", "additionalProperties":false, "required":["kind","invocationId"],
      "properties":{"kind":{"const":"cancel_invocation"},"invocationId":{"$ref":"#/$defs/invocationId"}}
    },
    "cancelSubmission": {
      "type":"object", "additionalProperties":false, "required":["kind","operationId"],
      "properties":{"kind":{"const":"cancel_submission"},"operationId":{"type":"string","pattern":"^op_[0-9a-f]{32}$"}}
    },
    "sessionId":{"type":"string","pattern":"^ses_[0-9a-f]{32}$"},
    "invocationId":{"type":"string","pattern":"^inv_[0-9a-f]{32}$"}
  }
}
