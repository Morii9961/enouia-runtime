{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Proposed Core job status and event polling v1 (design only)",
  "description":"Shape only. Backend must check binding, time/progress, state transitions, event identity/order and actual durable result proof.",
  "oneOf":[{"$ref":"#/$defs/status"},{"$ref":"#/$defs/pollRequest"},{"$ref":"#/$defs/pollResponse"}],
  "$defs":{
    "jobId":{"type":"string","pattern":"^job_[0-9a-f]{32}$"},
    "processId":{"type":"string","pattern":"^run_[0-9a-f]{32}$"},
    "nullableBinding":{"anyOf":[{"$ref":"../invocation/record-v1.schema.json#/$defs/binding"},{"type":"null"}]},
    "nullableTime":{"anyOf":[{"$ref":"../invocation/record-v1.schema.json#/$defs/time"},{"type":"null"}]},
    "status":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","kind","jobId","processId","jobKind","state","startedAt","updatedAt","pinnedBinding","resultBinding","phase","processed","total","eventSequence","canCancel","operationId","invocationId","previewCapsuleId","errorCode"],
      "properties":{
        "schemaVersion":{"const":1},"kind":{"const":"job_status"},
        "jobId":{"$ref":"#/$defs/jobId"},"processId":{"$ref":"#/$defs/processId"},
        "jobKind":{"enum":["index_rebuild","context_preview","mock_submission"]},
        "state":{"enum":["queued","running","cancel_requested","succeeded","failed","cancelled","interrupted"]},
        "startedAt":{"$ref":"#/$defs/nullableTime"},"updatedAt":{"$ref":"../invocation/record-v1.schema.json#/$defs/time"},
        "pinnedBinding":{"$ref":"#/$defs/nullableBinding"},"resultBinding":{"$ref":"#/$defs/nullableBinding"},
        "phase":{"enum":["queued","validate","project","publish","retrieve","prepare","dispatch","commit","terminal"]},
        "processed":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "total":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},
        "eventSequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"canCancel":{"type":"boolean"},
        "operationId":{"anyOf":[{"type":"string","pattern":"^op_[0-9a-f]{32}$"},{"type":"null"}]},
        "invocationId":{"anyOf":[{"type":"string","pattern":"^inv_[0-9a-f]{32}$"},{"type":"null"}]},
        "previewCapsuleId":{"anyOf":[{"type":"string","pattern":"^cap_[0-9a-f]{32}$"},{"type":"null"}]},
        "errorCode":{"enum":[null,"index_unavailable","index_corrupt","compile_refused","provider_refused","invalid_response","stale_generation","cancelled","worker_interrupted","storage_failed"]}
      }
    },
    "event":{
      "type":"object","additionalProperties":false,"required":["sequence","observedAt","status"],
      "properties":{"sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"observedAt":{"$ref":"../invocation/record-v1.schema.json#/$defs/time"},"status":{"$ref":"#/$defs/status"}}
    },
    "pollRequest":{
      "type":"object","additionalProperties":false,"required":["schemaVersion","kind","jobId","processId","afterSequence","limit"],
      "properties":{"schemaVersion":{"const":1},"kind":{"const":"poll_job_events"},"jobId":{"$ref":"#/$defs/jobId"},"processId":{"$ref":"#/$defs/processId"},"afterSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"type":"integer","minimum":1,"maximum":128}}
    },
    "pollResponse":{
      "type":"object","additionalProperties":false,"required":["schemaVersion","kind","jobId","processId","status","events","nextCursor","eventGap"],
      "properties":{"schemaVersion":{"const":1},"kind":{"const":"job_events"},"jobId":{"$ref":"#/$defs/jobId"},"processId":{"$ref":"#/$defs/processId"},"status":{"$ref":"#/$defs/status"},"events":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/event"}},"nextCursor":{"type":"integer","minimum":0,"maximum":9007199254740991},"eventGap":{"type":"boolean"}}
    }
  }
}
