{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Memory model snapshot v1",
  "description": "Pure model interchange, not a Vault persistence layout. Rust validates real calendar dates, ordering, whitespace, source resolution, unique IDs, candidate state and acyclic relations. Session turn order/resolution belongs to enouia-session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "memories",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "memoryId": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{32}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^cand_[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{32}$"
    },
    "turnId": {
      "type": "string",
      "pattern": "^turn_[0-9a-f]{32}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "turnRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_turn_id",
        "last_turn_id"
      ],
      "properties": {
        "first_turn_id": {
          "$ref": "#/$defs/turnId"
        },
        "last_turn_id": {
          "$ref": "#/$defs/turnId"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_at"
      ],
      "properties": {
        "starts_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ends_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "memory_id",
        "type",
        "content",
        "source_id",
        "created_at",
        "updated_at",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "memory_id": {
          "$ref": "#/$defs/memoryId"
        },
        "type": {
          "enum": [
            "fact",
            "preference",
            "episode",
            "project_state",
            "session_checkpoint"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "archived"
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/validity"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/memoryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_loops": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/sessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "covered_turns": {
          "anyOf": [
            {
              "$ref": "#/$defs/turnRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "project_state"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "project_id": {
                "$ref": "#/$defs/projectId"
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "null"
              },
              "covered_turns": {
                "type": "null"
              },
              "last_state": {
                "type": "null"
              }
            },
            "required": [
              "project_id",
              "state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session_checkpoint"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "session_id": {
                "$ref": "#/$defs/sessionId"
              },
              "covered_turns": {
                "$ref": "#/$defs/turnRange"
              },
              "last_state": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "null"
              },
              "decisions": {
                "maxItems": 0
              }
            },
            "required": [
              "session_id",
              "covered_turns",
              "last_state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fact"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "type": "null"
              },
              "decisions": {
                "maxItems": 0
              },
              "open_loops": {
                "maxItems": 0
              },
              "session_id": {
                "type": "null"
              },
              "covered_turns": {
                "type": "null"
              },
              "last_state": {
                "type": "null"
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "preference"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "type": "null"
              },
              "decisions": {
                "maxItems": 0
              },
              "open_loops": {
                "maxItems": 0
              },
              "session_id": {
                "type": "null"
              },
              "covered_turns": {
                "type": "null"
              },
              "last_state": {
                "type": "null"
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "episode"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "type": "null"
              },
              "decisions": {
                "maxItems": 0
              },
              "open_loops": {
                "maxItems": 0
              },
              "session_id": {
                "type": "null"
              },
              "covered_turns": {
                "type": "null"
              },
              "last_state": {
                "type": "null"
              }
            },
            "required": []
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "kind",
        "title",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "kind": {
          "enum": [
            "manual_save",
            "explicit_remember",
            "conversation_turn",
            "import"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/sessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/turnId"
            },
            {
              "type": "null"
            }
          ]
        },
        "importer_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "conversation_turn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "session_id",
              "turn_id"
            ],
            "properties": {
              "session_id": {
                "$ref": "#/$defs/sessionId"
              },
              "turn_id": {
                "$ref": "#/$defs/turnId"
              }
            }
          },
          "else": {
            "properties": {
              "session_id": {
                "type": "null"
              },
              "turn_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "import"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "importer_version",
              "raw_sha256"
            ],
            "properties": {
              "importer_version": {
                "type": "string",
                "minLength": 1
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "importer_version": {
                "type": "null"
              },
              "raw_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "pending"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "memory_id"
          ],
          "properties": {
            "status": {
              "const": "approved"
            },
            "memory_id": {
              "$ref": "#/$defs/memoryId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "rejected"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "candidate_id",
        "created_at",
        "updated_at",
        "proposal",
        "decision"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proposal": {
          "$ref": "#/$defs/memory"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      }
    }
  }
}
