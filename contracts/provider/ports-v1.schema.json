{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Provider/Tool ports v1",
  "description": "Only prepared validated capsule bytes enter Provider invocation. Tools propose candidates and cannot represent direct canonical commit. The initial Mock has no network or tool execution.",
  "oneOf": [
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/toolRequest"
    },
    {
      "$ref": "#/$defs/toolResult"
    }
  ],
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "max_input_units": {
          "type": "integer",
          "minimum": 256,
          "maximum": 9007199254740991
        },
        "token_policy": {
          "const": "utf8_bytes_v1"
        },
        "supports_tools": {
          "type": "boolean"
        },
        "network_required": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "provider_id",
        "max_input_units",
        "token_policy",
        "supports_tools",
        "network_required"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^req_[0-9a-f]{32}$"
        },
        "capsule": {
          "$ref": "../context/capsule-v1.schema.json"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "capsule"
      ]
    },
    "toolRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "propose_memory"
        },
        "call_id": {
          "type": "string",
          "pattern": "^tool_[0-9a-f]{32}$"
        },
        "draft": {
          "$ref": "../memory/draft-v1.schema.json"
        }
      },
      "required": [
        "tool",
        "call_id",
        "draft"
      ]
    },
    "toolResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "candidate_queued"
            },
            "call_id": {
              "type": "string",
              "pattern": "^tool_[0-9a-f]{32}$"
            },
            "candidate_id": {
              "type": "string",
              "pattern": "^cand_[0-9a-f]{32}$"
            }
          },
          "required": [
            "status",
            "call_id",
            "candidate_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unsupported"
            },
            "call_id": {
              "type": "string",
              "pattern": "^tool_[0-9a-f]{32}$"
            }
          },
          "required": [
            "status",
            "call_id"
          ]
        }
      ]
    },
    "projectReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "type": "string",
          "pattern": "^mem_[0-9a-f]{32}$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "open_loops": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "memory_id",
        "content",
        "state",
        "open_loops"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^req_[0-9a-f]{32}$"
        },
        "capsule_id": {
          "type": "string",
          "pattern": "^cap_[0-9a-f]{32}$"
        },
        "consumed_capsule_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "consumed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "project_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReference"
          }
        },
        "tool_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolRequest"
          }
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "capsule_id",
        "consumed_capsule_sha256",
        "consumed_bytes",
        "text",
        "project_states",
        "tool_requests"
      ]
    }
  }
}
