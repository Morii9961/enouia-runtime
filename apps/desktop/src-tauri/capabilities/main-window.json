{
  "identifier": "main-window",
  "description": "The main window: window controls plus the Memory adapter commands. No fs, shell, http, dialog, opener, provider or Activity permission exists.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-memory-call",
    "allow-memory-pick",
    "allow-shell-status",
    "allow-shell-show",
    "allow-shell-search",
    "allow-shell-exit"
  ]
}
